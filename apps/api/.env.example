APP_NAME=University Decision Support API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=university_dss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# YOKSIS live integration options
YOKSIS_BASE_URL=https://example.yoksis.endpoint
YOKSIS_API_KEY=
YOKSIS_USERNAME=
YOKSIS_PASSWORD=

# Optional mock YOKSIS server
YOKSIS_MOCK_ENABLED=true
YOKSIS_MOCK_AUTH_TYPE=api_key
YOKSIS_MOCK_API_KEY=mock-yoksis-key
YOKSIS_MOCK_USERNAME=mock-user
YOKSIS_MOCK_PASSWORD=mock-pass

# YOK Akademik HTML adapter
YOK_AKADEMIK_BASE_URL=https://akademik.yok.gov.tr
YOK_AKADEMIK_SEARCH_PATH=/AkademikArama/
YOK_AKADEMIK_PROFILE_PATH=/AkademikArama/view/viewAuthor.jsp
YOK_AKADEMIK_TIMEOUT_SECONDS=30
YOK_AKADEMIK_LIVE_ENABLED=true